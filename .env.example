# Copie para .env e preencha. O .env NUNCA deve ir para o Git.

# WMS Stokki: endpoint de saldo por SKU e token de API
STOKKI_URL=https://SUA_EMPRESA.stokki.com.br/api/stokki/oms/inventory/show
STOKKI_TOKEN=

# Planilha de vendas (aba com Data, Produto e KG)
SHEET_ID=
SHEET_NAME=fVendas

# IA (Claude). Sem a chave, o botão de recomendação fica desativado.
ANTHROPIC_API_KEY=

# Segmento usado no prompt da IA
SEGMENTO=lâminas de aço silício para transformadores

# Arquivo local com pedidos, projeções e cenários
DATA_FILE=compras_data.json
